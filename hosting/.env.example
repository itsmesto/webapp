# Use a persistent directory on the hosting provider, not an ephemeral temp path.
LEDGER_DATA_DIR=./data
LEDGER_DB=./data/ledgerly.sqlite
HOST=0.0.0.0
PORT=8080

# Comma-separated HTTPS origins allowed to call the API with login cookies.
# Android remote mode normally needs https://appassets.androidplatform.net.
# Add the desktop/web origin if it is hosted separately.
INVOICEY_CORS_ORIGIN=https://appassets.androidplatform.net

# Leave unset/1 on HTTPS hosting. Use 0 only for local HTTP smoke tests.
INVOICEY_COOKIE_SECURE=1

